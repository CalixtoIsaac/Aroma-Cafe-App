# Conexión a MySQL (copia este archivo como .env y pon tu contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_NAME=AROMA_CAFE_db

# Puerto interno de la API (la página se abre en el 8080)
API_PORT=3001

# Llave para cifrar las contraseñas de los empleados (el servidor la genera sola
# la primera vez si no existe). No la cambies: las contraseñas guardadas dejarían
# de poder consultarse.
APP_SECRET=
